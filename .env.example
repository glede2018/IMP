# 项目统一配置：API、前端开发工具和 Docker Compose 均从根目录读取。
# 环境中已注入的变量优先；修改后需重启相应服务。
# 本文件含敏感信息，不要提交到版本库。

# ==================== 一、应用与登录 ====================

# 前端访问地址，用于跨域与请求来源校验；需与实际访问域名一致。
APP_ORIGIN=http://localhost:8080

# 额外允许的前端来源，多个用英文逗号分隔；本地可填 http://localhost:8080，生产留空。
APP_ALLOWED_ORIGINS=

# API 本地启动端口；Docker 容器内固定为 3001。
PORT="3001"

# 登录会话有效天数；同一账号新登录会让旧会话立即失效。
SESSION_DAYS="7"

# 可信代理范围：默认本机和 Docker 私网；公网入口 Nginx 必须覆盖客户端传入的转发头。
# 使用负载均衡等其他代理时，按实际代理地址或网段缩小配置；false 表示关闭。
TRUSTED_PROXY_CIDRS=loopback,uniquelocal

# ==================== 二、数据库 ====================

# 仅本地开发容器使用；阿里云 PostgreSQL 账号填写在 DATABASE_URL 中。
POSTGRES_USER=imp

# 仅本地开发容器使用；已有数据库卷不会因修改此项自动更改密码。
POSTGRES_PASSWORD=imp_local_password

# 仅本地开发容器使用的数据库名。
POSTGRES_DB=imp

# 服务器 API 和 Prisma 共用阿里云 PostgreSQL 连接地址，Compose 原样传入，不再覆盖。
# 优先使用与 ECS 同地域、同 VPC 的 RDS 内网地址，并在 RDS 白名单放行 ECS 私网 IP。
# 提前创建数据库和账号，授予目标库的迁移权限；密码中的 @、#、: 等字符需 URL 编码。
# 按 RDS 的 SSL 设置追加 sslmode=require 等连接参数。
DATABASE_URL="postgresql://db_user:replace_with_url_encoded_password@your-rds-host:5432/imp?schema=public"

# ==================== 三、初始管理员 ====================

# 首次初始化的管理员手机号。
BOOTSTRAP_PHONE=13800138000

# 首次初始化的管理员密码；已有账号不会被启动脚本重置密码。
BOOTSTRAP_PASSWORD=ChangeThisLocalPassword123!

# 管理员显示名称。
BOOTSTRAP_NAME=运营管理员

# ==================== 四、文件存储与阿里云 OSS ====================

# 新上传文件的存储方式：oss 为阿里云，s3 为本地 RustFS。
STORAGE_PROVIDER=oss

# OSS 地域，例如 oss-cn-beijing。
OSS_REGION=

# 已创建的公共读 Bucket 名称。
OSS_BUCKET=

# 后端使用的阿里云访问凭据，不提供给浏览器。
OSS_ACCESS_KEY_ID=

# 阿里云访问密钥，请勿提交 Git 或发送到聊天中。
OSS_ACCESS_KEY_SECRET=

# OSS 自定义访问域名：预览使用公共读固定直链，下载时即时生成文件名响应。
OSS_ACCESS_DOMAIN=

# 可选的 OSS 官方服务端点；留空按地域自动选择，不填写自定义访问域名。
OSS_ENDPOINT=

# ==================== 五、本地存储与历史素材 ====================

# 仅本地开发或历史 S3 文件使用；本地 Compose 覆盖为 storage:9000，服务器不启动 RustFS。
S3_ENDPOINT="http://localhost:9000"

# 本地 S3 兼容存储地域。
S3_REGION="us-east-1"

# 本地素材 Bucket，读取历史素材时仍需保留。
S3_BUCKET="imp-files"

# 本地 RustFS 账号，和 OSS 访问凭据相互独立。
S3_ACCESS_KEY=imp_local

# 本地 RustFS 密码；切换 OSS 后仍用于读取旧文件。
S3_SECRET_KEY=imp_local_storage_password

# ==================== 六、抖音授权与数据同步 ====================

# 抖音开放平台网站应用的 Client Key。
DOUYIN_CLIENT_KEY=

# 抖音网站应用密钥，仅供后端调用。
DOUYIN_CLIENT_SECRET=

# 授权回调地址，需与抖音开放平台配置完全一致。
DOUYIN_REDIRECT_URI=

# 授权权限，多个权限用英文逗号分隔；仅填写已获批权限。
DOUYIN_SCOPES=user_info

# OAuth 令牌加密密钥：Base64 编码的 32 字节密钥；已有授权后不要随意更换。
OAUTH_TOKEN_ENCRYPTION_KEY=

# 视频同步接口：disabled 为关闭；能力获批并验证后可用 website_v1。
DOUYIN_VIDEO_API_PROFILE=disabled

# 粉丝同步开关，获批并验证后才能开启。
DOUYIN_FANS_SYNC_ENABLED=false

# 仅供本机地址使用的模拟授权；线上域名无法启用。
DOUYIN_DEMO_ENABLED=false

# ==================== 七、前端本地开发 ====================

# Vite 开发代理目标；生产环境使用同域 /api，不依赖此项。仅 VITE_ 前缀变量允许提供给浏览器，禁止用此前缀保存密钥。
VITE_API_PROXY="http://localhost:3001"

# ==================== 八、工作流模型服务（后续配置） ====================

# 单节点模型服务地址，不是 CreatKey 的工作流执行地址；接口约定见 README。
WORKFLOW_PROVIDER_URL=

# 模型服务访问密钥，仅供 API 使用。
WORKFLOW_PROVIDER_KEY=

# CreatKey 模型 UUID 到供应商模型名称的 JSON 映射，例如 {"原模型UUID":"供应商模型名"}。
WORKFLOW_MODEL_MAP='{}'

# 允许下载生成结果的 HTTPS 域名，多个域名用英文逗号分隔，不填写通配符。
WORKFLOW_OUTPUT_HOSTS=
