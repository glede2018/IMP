NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://imp:imp_local_password@localhost:55432/imp?schema=public
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=imp-files
S3_ACCESS_KEY=imp_local
S3_SECRET_KEY=imp_local_storage_password
SESSION_DAYS=7
BOOTSTRAP_PHONE=13800138000
BOOTSTRAP_PASSWORD=ChangeThisLocalPassword123!
BOOTSTRAP_NAME=运营管理员

# Douyin website OAuth: configure after application approval.
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=
DOUYIN_SCOPES=user_info
# Base64-encoded 32-byte key. setup-local generates this automatically.
OAUTH_TOKEN_ENCRYPTION_KEY=
# Explicit opt-in, only available when APP_ORIGIN is localhost/loopback.
DOUYIN_DEMO_ENABLED=false
