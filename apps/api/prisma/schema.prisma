generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum Role {
 admin
 operator
 reviewer
 viewer
}
model Organization {
 id String @id @default(cuid())
 name String
 createdAt DateTime @default(now())
 users User[]
 stores Store[]
 accounts Account[]
 assets Asset[]
 templates Template[]
 works Work[]
 resources HelpResource[]
 audits AuditLog[]
 roles AccessRole[]
 materials Material[]
 categories MaterialCategory[]
}

model Store {
 id String @id @default(cuid())
 name String
 organizationId String
 organization Organization @relation(fields:[organizationId], references:[id])
 accounts Account[]
 createdAt DateTime @default(now())
 @@unique([organizationId,name])
}
model User {
 id String @id @default(cuid())
 username String @unique
 lastLoginAt DateTime?
 assignments UserRole[]
 phone String @unique
 name String
 passwordHash String
 role Role @default(viewer)
 active Boolean @default(true)
 organizationId String
 organization Organization @relation(fields:[organizationId], references:[id])
 createdAt DateTime @default(now())
 sessions Session[]
 @@index([organizationId])
}
model Session {
 id String @id
 userId String @unique
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 expiresAt DateTime
 createdAt DateTime @default(now())
 oauthStates OAuthState[]
 @@index([expiresAt])
}
model Account {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id])
 storeId String?
 store Store? @relation(fields:[storeId],references:[id],onDelete:SetNull)
 platform String
 nickname String
 accountId String
 tier String
 status String @default("warning")
 bindTime DateTime @default(now())
 updatedAt DateTime @updatedAt
 avatar String?
 authorization AccountAuthorization?
 platformVideos PlatformVideo[]
 metricSamples AccountMetricSample[]
 syncStates DouyinSyncState[]
 @@unique([organizationId,platform,accountId])
 @@index([platform,id])
}
model Asset {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id])
 type String
 name String
 tags String[] @default([])
 retained Boolean @default(false)
 objectKey String @unique
 mimeType String
 size Int
 createdAt DateTime @default(now())
 materialFiles MaterialFile[]
 materialVoices Material[] @relation("MaterialVoice")
 templateCovers Template[]
 works Work[]
 @@index([organizationId,type])
}
model Template {
 revision Int @default(1)
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id])
 title String
 description String
 category String
 tags String[] @default([])
 config Json @default("{}")
 coverAssetId String?
 coverAsset Asset? @relation(fields:[coverAssetId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 works Work[]
 trackingTags TemplateTrackingTag[]
 creationDrafts VideoCreationDraft[]
 @@index([organizationId,category])
}
enum WorkStatus {
 draft
 review
 approved
 rejected
}
model Work {
 caption String @default("")
 publishTags String[] @default([])
 templateSnapshot Json?
 creationId String? @unique
 creation VideoCreationDraft? @relation(fields:[creationId],references:[id],onDelete:Restrict)
 width Int?
 height Int?
 generationSeconds Int?
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id])
 title String
 materialSnapshot Json?
 status WorkStatus @default(draft)
 assetId String
 asset Asset @relation(fields:[assetId],references:[id],onDelete:Restrict)
 templateId String?
 template Template? @relation(fields:[templateId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([organizationId,status])
}
model HelpResource {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id])
 title String
 type String
 description String?
 url String?
 createdAt DateTime @default(now())
 @@index([organizationId])
}
model AuditLog {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id])
 actorId String
 action String
 entityId String
 createdAt DateTime @default(now())
 @@index([organizationId,createdAt])
}

model OAuthState {
 id String @id
 sessionId String
 session Session @relation(fields:[sessionId],references:[id],onDelete:Cascade)
 organizationId String
 actorId String
 tier String
 storeId String?
 targetAccountId String?
 mode String
 clientKey String
 redirectUri String
 expiresAt DateTime
 createdAt DateTime @default(now())
 @@index([expiresAt])
}
model AccountAuthorization {
 accountId String @id
 account Account @relation(fields:[accountId],references:[id],onDelete:Cascade)
 mode String
 clientKey String
 openId String
 scopes String[] @default([])
 accessTokenCiphertext String?
 refreshTokenCiphertext String?
 accessExpiresAt DateTime
 refreshExpiresAt DateTime
 lastVerifiedAt DateTime
 refreshLockUntil DateTime?
 revision Int @default(0)
 @@unique([clientKey,openId])
 @@index([accessExpiresAt])
}

model AccessRole {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id])
 name String
 code String
 description String @default("")
 sort Int @default(0)
 active Boolean @default(true)
 system Boolean @default(false)
 permissions String[] @default([])
 createdAt DateTime @default(now())
 users UserRole[]
 @@unique([organizationId,code])
}
model UserRole {
 userId String
 roleId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 role AccessRole @relation(fields:[roleId],references:[id],onDelete:Restrict)
 @@id([userId,roleId])
}

model Material {
 materialDescription String @default("")
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id])
 type String
 name String
 description String @default("")
 categoryId String?
 category MaterialCategory? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
 categoryPath String[] @default([])
 tags String[] @default([])
 priceCents Int @default(0)
 creatorId String
 creatorName String
 voiceAssetId String?
 voiceAsset Asset? @relation("MaterialVoice",fields:[voiceAssetId],references:[id],onDelete:Restrict)
 isDefault Boolean @default(false)
 generationStatus String @default("reference")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 deletedAt DateTime?
 files MaterialFile[]
 @@index([organizationId,type,deletedAt,createdAt])
}
model MaterialFile {
 id String @id @default(cuid())
 materialId String
 material Material @relation(fields:[materialId],references:[id],onDelete:Cascade)
 assetId String
 asset Asset @relation(fields:[assetId],references:[id],onDelete:Restrict)
 position Int
 label String @default("主图")
 @@unique([materialId,assetId])
 @@index([assetId])
}

model MaterialCategory {
 id String @id @default(cuid())
 organizationId String
 organization Organization @relation(fields:[organizationId],references:[id])
 name String
 parentId String?
 parent MaterialCategory? @relation("CategoryTree",fields:[parentId],references:[id],onDelete:Restrict)
 children MaterialCategory[] @relation("CategoryTree")
 sort Int @default(0)
 system Boolean @default(false)
 createdAt DateTime @default(now())
 materials Material[]
 @@index([organizationId,parentId])
}

model TemplateTrackingTag {
 id String @id @default(cuid())
 organizationId String
 templateId String?
 template Template? @relation(fields:[templateId],references:[id],onDelete:Restrict)
 tag String
 name String @default("")
 code String?
 description String @default("")
 sort Int @default(0)
 active Boolean @default(true)
 deletedAt DateTime?
 version String @default("")
 titleSnapshot String @default("")
 createdAt DateTime @default(now())
 videos PlatformVideo[]
 @@unique([organizationId,tag])
 @@unique([organizationId,code])
 @@index([organizationId,templateId])
}
model PlatformVideo {
 id String @id @default(cuid())
 organizationId String
 accountId String
 account Account @relation(fields:[accountId],references:[id],onDelete:Cascade)
 remoteId String
 title String
 tags String[] @default([])
 publishedAt DateTime
 bindingId String?
 binding TemplateTrackingTag? @relation(fields:[bindingId],references:[id],onDelete:SetNull)
 matchStatus String @default("unmatched")
 lastSeenAt DateTime @default(now())
 samples VideoMetricSample[]
 @@unique([accountId,remoteId])
 @@index([organizationId,publishedAt])
}
model VideoMetricSample {
 id String @id @default(cuid())
 videoId String
 video PlatformVideo @relation(fields:[videoId],references:[id],onDelete:Cascade)
 bucket DateTime
 capturedAt DateTime
 views BigInt
 likes BigInt
 comments BigInt
 shares BigInt
 @@unique([videoId,bucket])
 @@index([videoId,capturedAt])
}
model AccountMetricSample {
 id String @id @default(cuid())
 accountId String
 account Account @relation(fields:[accountId],references:[id],onDelete:Cascade)
 bucket DateTime
 capturedAt DateTime
 fans BigInt
 @@unique([accountId,bucket])
 @@index([accountId,capturedAt])
}
model DouyinSyncState {
 id String @id @default(cuid())
 accountId String
 account Account @relation(fields:[accountId],references:[id],onDelete:Cascade)
 kind String
 status String @default("idle")
 message String @default("")
 cursor String @default("0")
 runId String?
 leaseUntil DateTime?
 nextAttemptAt DateTime?
 lastSuccessAt DateTime?
 lastAttemptAt DateTime?
 failures Int @default(0)
 processed Int @default(0)
 updatedAt DateTime @updatedAt
 @@unique([accountId,kind])
 @@index([status,nextAttemptAt])
}

model VideoCreationDraft {
 workflowSnapshot Json?
 nodeStates Json @default("{}")
 error String?
 leaseUntil DateTime?
 startedAt DateTime?
 finishedAt DateTime?
 work Work?
 id String @id @default(cuid())
 organizationId String
 creatorId String
 templateId String
 template Template @relation(fields:[templateId],references:[id],onDelete:Restrict)
 revision Int
 title String
 contentTagIds String[]
 publishTags String[]
 trackingTagId String
 templateSnapshot Json
 materialSnapshot Json
 status String @default("awaiting_provider")
 requestId String
 createdAt DateTime @default(now())
 @@index([status,leaseUntil])
 @@unique([organizationId,requestId])
 @@index([organizationId,createdAt])
}
